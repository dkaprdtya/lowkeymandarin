{
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "editor.rulers": [100],
  "editor.formatOnSave": false,
  "editor.trimAutoWhitespace": true,
  "search.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/instance": true,
    "**/backups": true,
    "**/.venv": true
  },
  "files.watcherExclude": {
    "**/__pycache__/**": true,
    "**/instance/**": true,
    "**/backups/**": true,
    "**/.venv/**": true
  },
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.extraPaths": ["."],
  "[python]": {
    "editor.tabSize": 4,
    "editor.defaultFormatter": "ms-python.python"
  },
  "[javascript]": {
    "editor.tabSize": 2
  },
  "[css]": {
    "editor.tabSize": 2
  },
  "[html]": {
    "editor.tabSize": 2
  }
}
