{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Lowkey Mandarin: Flask (debug)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "FLASK_DEBUG": "1",
        "PORT": "5000"
      }
    },
    {
      "name": "Lowkey Mandarin: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
