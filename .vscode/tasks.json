{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Lowkey Mandarin: dev server",
      "type": "shell",
      "command": "python app.py",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "FLASK_DEBUG": "1",
          "PORT": "5000"
        }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Lowkey Mandarin: install dependencies",
      "type": "shell",
      "command": "python -m pip install -r requirements.txt",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Lowkey Mandarin: check Python syntax",
      "type": "shell",
      "command": "Get-ChildItem -Filter *.py | ForEach-Object { python -m py_compile $_.FullName }",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Lowkey Mandarin: check JavaScript syntax",
      "type": "shell",
      "command": "Get-ChildItem static/js -Recurse -Filter *.js | ForEach-Object { node --check $_.FullName }",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Lowkey Mandarin: backup database",
      "type": "shell",
      "command": "python backup.py --out backups",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
