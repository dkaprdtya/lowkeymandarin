# Lowkey Mandarin environment template.
# Copy to .env for Docker Compose, or load these values from your process
# manager. Never commit the real .env file.

# PostgreSQL connection string. When set, the app uses PostgreSQL instead of
# SQLite and creates/seeds the schema on first start. Required on serverless
# platforms (Vercel), whose filesystem cannot hold a database.
# Example: postgresql://user:password@host/dbname?sslmode=require
# Keep this value in the host's environment settings, never in the repository.
# A Vercel/Neon integration may instead create POSTGRES_URL, POSTGRES_PRISMA_URL,
# POSTGRES_URL_NON_POOLING or DATABASE_URL_UNPOOLED; any of them works.
DATABASE_URL=

# Absolute path to the SQLite database. The Docker image uses /data/hanzi.db.
# Ignored when DATABASE_URL is set.
HANZI_DB=/data/hanzi.db

# Serverless platforms have no durable filesystem. If a deployment has neither
# DATABASE_URL nor a writable volume, the API answers 503 instead of writing
# accounts to storage that disappears. Set this to 1 only for a throwaway demo.
HANZI_ALLOW_EPHEMERAL=0

# Public origin without a trailing slash. Used in password-reset links.
HANZI_PUBLIC_URL=https://hanzi.example.com

# Contact address shown on the contact page.
HANZI_CONTACT_EMAIL=hello@example.com

# Set to 1 behind HTTPS so the session and CSRF cookies are Secure.
# Use 0 only for local HTTP testing.
HANZI_COOKIE_SECURE=1

# Set to 1 only when a trusted reverse proxy sets X-Forwarded-* headers.
# Leave unset for a direct connection.
HANZI_TRUST_PROXY=1

# Extra Host header values accepted by the app, comma separated. The host in
# HANZI_PUBLIC_URL and loopback are always allowed when this is set. Useful for
# a staging hostname or an IP-based health check.
HANZI_TRUSTED_HOSTS=

# Largest request body in bytes. Raise only if an upload endpoint needs it.
HANZI_MAX_BODY=262144

# Optional password-reset delivery. Without these values the reset endpoint
# answers 503 and the interface hides the reset form. A reset also requires
# HANZI_PUBLIC_URL with an https origin; http is accepted only for localhost.
HANZI_SMTP_HOST=
HANZI_SMTP_PORT=587
HANZI_SMTP_USER=
HANZI_SMTP_PASSWORD=
HANZI_SMTP_FROM=
# Set to 0 only when the SMTP server does not support STARTTLS.
HANZI_SMTP_TLS=1
