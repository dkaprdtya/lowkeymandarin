# Copy to /etc/hanzi-flow.env and chmod 600. Never commit real secrets.
HANZI_DB=/var/lib/hanzi-flow/hanzi.db
HANZI_PUBLIC_URL=https://hanzi.example.com
HANZI_CONTACT_EMAIL=hello@example.com
HANZI_COOKIE_SECURE=1
HANZI_TRUST_PROXY=1
HANZI_TRUSTED_HOSTS=
HANZI_MAX_BODY=262144
# Password reset needs SMTP plus an https HANZI_PUBLIC_URL. Leave SMTP empty
# to keep reset disabled; the interface hides the form and the API returns 503.
HANZI_SMTP_HOST=
HANZI_SMTP_PORT=587
HANZI_SMTP_USER=
HANZI_SMTP_PASSWORD=
HANZI_SMTP_FROM=
HANZI_SMTP_TLS=1
