# Lowkey Mandarin reverse-proxy example for Nginx.
# Replace hanzi.example.com and the certificate paths, then enable the site.
#
# The app listens on loopback only. Nginx terminates TLS and forwards the
# client address and scheme; HANZI_TRUST_PROXY=1 tells the app to trust them.

server {
    listen 80;
    listen [::]:80;
    server_name hanzi.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name hanzi.example.com;

    ssl_certificate     /etc/letsencrypt/live/hanzi.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hanzi.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    server_tokens       off;

    client_max_body_size 1m;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;
        proxy_read_timeout 60s;
    }

    # Stable filenames change on deploy, so keep caching short.
    location /static/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        expires 1h;
    }
}
