# Local runtime state
instance/*
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backups/
# The content-only archive ships with Git deployments so Vercel can serve
# read-only browsing before a PostgreSQL database is attached. It holds no
# accounts and no personal data.
!instance/hanzi.db

# Secrets and local environment
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Tooling and OS
.pytest_cache/
.ruff_cache/
.mypy_cache/
.DS_Store
Thumbs.db
